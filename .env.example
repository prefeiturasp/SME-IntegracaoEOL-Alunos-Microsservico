SME_SDK_ENABLED=true
SME_SERVICE_NAME=alunos-ms
SME_SERVICE_VERSION=0.1.0
SME_ENVIRONMENT=local

SME_TIMEOUT_ENABLED=true
SME_TIMEOUT_SECONDS=10
SME_RETRY_ENABLED=true
SME_RETRY_ATTEMPTS=3
SME_RETRY_BACKOFF_MIN=0.5
SME_RETRY_BACKOFF_MAX=5
SME_CIRCUIT_BREAKER_ENABLED=true
SME_CIRCUIT_BREAKER_FAIL_MAX=5
SME_CIRCUIT_BREAKER_RESET_TIMEOUT=30

SME_LOGGING_ENABLED=true
SME_LOG_LEVEL=INFO
SME_LOG_FORMAT=json
SME_CORRELATION_ID_HEADER=X-Request-ID

SME_OBSERVABILITY_BACKEND=elastic
SME_OTEL_ENABLED=false
SME_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
SME_OTEL_EXPORTER_OTLP_HEADERS=
SME_OTEL_EXPORTER_OTLP_INSECURE=true

SME_BROKER=rabbitmq
SME_BROKER_URL=amqp://guest:guest@rabbitmq:5672/%2F
SME_LOG_QUEUE=
SME_LOG_QUEUE_BUFFER_SIZE=10000
SME_LOG_QUEUE_SOCKET_TIMEOUT=2
SME_LOG_QUEUE_POLL_INTERVAL=0.25
SME_LOG_QUEUE_SHUTDOWN_TIMEOUT=2

DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-forte
DJANGO_DEBUG=valor
DJANGO_ALLOWED_HOSTS=*

API_KEY=trocar_esta_chave_em_ambiente_real
API_KEY_HEADER=X-API-Key

PORT_WEB=porta
PORT_DEBUGPY=valor

DB_POOL_SIZE=valor

URL_BANCO_ALUNOS=postgresql://usuario:senha@host:porta/banco
